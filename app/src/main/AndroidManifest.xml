<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".UnaPlannerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_unaplanner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_unaplanner_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UNAPLANNER"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Default channel for Firebase notifications when the app is in the background -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="unaplanner_notifications" />
        <!-- Monochromatic icon for system-handled notifications (notification payload) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_unaplanner_monochrome" />
        <!-- Accent color for notification -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/splash_background" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UNAPLANNER">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service that receives tokens and push messages from Firebase -->
        <service
            android:name=".notifications.UNAPlannerFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>

